rules_version = '2';

// Paste into Firebase console → Firestore Database → Rules, then Publish.
//
// pins/{pinKey} maps a stretched PIN to a family id. Documents can only be fetched by exact id,
// never listed, so a visitor needs the PIN to find the family's data.
service cloud.firestore {
  match /databases/{database}/documents {
    match /pins/{pinKey} {
      allow get: if true;
    }

    // Same idea for the admin PIN. It only gates actions inside the app; see docs/games-setup.md.
    match /adminPins/{adminKey} {
      allow get: if true;
    }

    // Links a signed-in account to its family and player. Only that account can read or write its own link.
    match /members/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.familyId is string
        && request.resource.data.playerId is string;
    }

    match /families/{familyId}/players/{playerId} {
      allow read, delete: if true;
      allow create, update: if request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40;
    }

    match /families/{familyId}/games/{gameId} {
      allow read, delete: if true;
      allow create, update: if request.resource.data.status in ['in-progress', 'completed']
        && request.resource.data.playerIds is list
        && request.resource.data.rounds is list;
    }
  }
}
